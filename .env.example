# ──────────────────────────────────────────────────────────────
# Alpaca Trading Bot — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ──────────────────────────────────────────────────────────────

# Account execution mode: "paper" or "live"
ALPACA_ACCOUNT_MODE=paper

# Paper trading credentials (required)
ALPACA_PAPER_KEY_ID=your_paper_key_id
ALPACA_PAPER_SECRET_KEY=your_paper_secret_key

# Live trading credentials (real money — use with caution)
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# ── News / Sentiment (all optional — falls back to free VADER) ──

# Google Gemini API key (news sentiment via gemini-3.6-flash)
GEMINI_API_KEY=

# Webz.io news API token (primary news source, optional)
WEBZ_TOKEN=

# NewsAPI.org key (fallback news source, optional)
NEWSAPI_KEY=

# ── Infrastructure ────────────────────────────────────────────

# Server port
PORT=3000

# Redis connection URL (optional — in-memory fallback)
REDIS_URL=redis://127.0.0.1:6379
