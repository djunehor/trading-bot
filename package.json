{
  "name": "alpaca-trading-automation",
  "version": "1.0.0",
  "description": "Automated Stock Trading Application with Alpaca API, News Sentiment Engine, Paper/Live Account Switch, and Extended Hours Support",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "test": "NODE_ENV=test tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:cov": "npx -y c8 --check-coverage --lines 80 --statements 80 --functions 80 npm test",
    "lint": "tsc --noEmit",
    "eslint": "eslint src tests",
    "eslint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^4.0.1",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "vader-sentiment": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.13.1",
    "c8": "^10.1.3",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
