{
  "name": "alpaca-trading-automation",
  "version": "1.0.0",
  "description": "Automated Stock Trading Application with Alpaca API, News Sentiment Engine, Paper/Live Account Switch, and Extended Hours Support",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute trading_db --local --file=./migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute trading_db --remote --file=./migrations/0001_initial.sql",
    "legacy:start": "node dist/main.js",
    "legacy:dev": "tsx watch src/main.ts",
    "test": "NODE_ENV=test tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:cov": "npx -y c8 --check-coverage --lines 80 --statements 80 --functions 80 npm test"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^4.0.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "vader-sentiment": "^1.1.3",
    "wrangler": "^4.152.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.13.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "c8": "^10.1.3",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
